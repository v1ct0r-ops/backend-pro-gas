
# ── Base de datos (REQUERIDA) ────────────────────────────────
# Cadena de conexión PostgreSQL.
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_bd?sslmode=require
#
#   • Local (Docker):  postgresql+psycopg2://usuario:password@localhost:5433/pro_gas_erp
#   • Producción (Neon): obtenla en https://console.neon.tech
#     -> tu proyecto -> Connection Details (incluye ?sslmode=require)
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5433/pro_gas_erp

# ── Base de datos de TEST (opcional, solo para pytest) ───────
# tests/conftest.py exige que sea DISTINTA de DATABASE_URL y que el
# nombre de la BD contenga "test" (protege la BD de producción).
# Déjala comentada si no corres la suite de tests.
# TEST_DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5433/pro_gas_test

# ── Aplicación ───────────────────────────────────────────────
APP_ENV=development          # development | production
APP_DEBUG=False              # True solo en desarrollo local

# ── Autenticación JWT ────────────────────────────────────────
# SECRET_KEY (REQUERIDA): cadena aleatoria de al menos 256 bits.
# Genérarla, por ejemplo, con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=reemplazar-con-cadena-aleatoria-larga-y-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=480   # TTL del token en minutos (default 480 = 8h) solo por hecho de que es interno no comprete dato comprometedores.


# ── CORS ─────────────────────────────────────────────────────
# Orígenes permitidos, separados por coma y SIN espacios sobrantes.
#   • Desarrollo: incluye el puerto de tu dev server Vite.
#   • Producción: solo tu dominio público (ej. https://tu-app.vercel.app).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── Correo transaccional: Resend (opcional) ──────────────────
# API para el Reporte Diario automático. Si se deja vacía, el envío
# se omite silenciosamente. Obtén la key en https://resend.com/api-keys
RESEND_API_KEY=
# Destinatario del reporte automático de cierre diario (super admin).
SUPER_ADMIN_EMAIL=

# ── Correo vía SMTP (opcional, alternativa a Resend) ─────────
# Si no se configuran, el envío por SMTP se omite silenciosamente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
